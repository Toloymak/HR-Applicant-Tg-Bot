@attribute [Route(HrUsersLinks.Create)]
@using Application.Client.Components
@using Application.Client.Constants.Links
@using Application.Client.Pages.Users.Models
@using Application.Client.Services.HrUsers

@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IHrUserService HrUserService

<TitleBlock Title="Add HR" />

<MudForm>

<MudCard>
    <MudCardHeader>
        <MudText Typo="Typo.h3">Base description</MudText>
    </MudCardHeader>
    <MudCardContent Style="display: flex; flex-direction: column; gap: 10px;">
        <MudTextField Label="Name" @bind-Value="_newHr.TgName"
                      MaxLength="200"
                      Margin="Margin.Normal"/>

        <MudTextField Label="Alias"
                      @bind-Value="_newHr.Alias"
                      MaxLength="200"
                      AutoGrow="true"/>
        
        <MudTextField Label="Position"
                      @bind-Value="_newHr.Position"
                      MaxLength="200"
                      AutoGrow="true"/>
    </MudCardContent>
    
    <MudCardActions>
        <MudButton OnClick="Create">Create</MudButton>
    </MudCardActions>
</MudCard>

</MudForm>

@code {
    private readonly NewHrUser _newHr = new();
    
    public async Task Create()
    {
        await HrUserService.CreateHrUser(_newHr, CancellationToken.None)
            .ToAsync()
            .Match(
                _ => {
                    Snackbar.Add("HR user created successfully!", Severity.Success);
                    Navigation.NavigateTo(HrUsersLinks.List);
                },
                _ => Snackbar.Add($"Error creating HR user", Severity.Error));
    }
}