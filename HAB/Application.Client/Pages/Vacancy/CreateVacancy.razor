@page "/vacancies/create"
@using Shared.Models.Requests
@using UiShared.Sercvies
@using Application.Client.Components
@using Application.Client.Constants.Links
@using Application.Client.Pages.Vacancy
@inject ICreateVacancy CreateVacancyService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<TitleBlock Title="Create New Vacancy" />

<MudForm @ref="_form">
    <MudCard>
        <MudCardHeader>
            <MudText Typo="Typo.h3">Vacancy Details</MudText>
        </MudCardHeader>
        <MudCardContent Style="display: flex; flex-direction: column; gap: 10px;">
            <MudTextField Label="Name"
                          @bind-Value="_model.Title"
                          MaxLength="200"
                          Margin="Margin.Normal"
                          Required="true"/>
            
            <MudTextField Label="Description"
                          @bind-Value="_model.Description"
                          MaxLength="1000"
                          AutoGrow="true"/>
            
            <MudTextField Label="Default accepted to review text"
                          @bind-Value="_model.DefaultAcceptedToReviewText"
                          HelperText="Text shown to candidate when application is finished" MaxLength="1000"
                          AutoGrow="true"/>
            
            <MudTextField Label="Default rejected text"
                          @bind-Value="_model.DefaultRejectText"
                          HelperText="Text shown to candidate when HR rejects application"
                          MaxLength="1000"
                          AutoGrow="true"/>
        </MudCardContent>
    </MudCard>
    <MudCard>
        <MudCardActions Style="justify-content: end; gap: 30px;">
            <MudButton OnClick="OnBack"
                       Color="Color.Secondary"
                       Variant="Variant.Text">
                Back
            </MudButton>
            <MudButton OnClick="OnClear"
                       Color="Color.Warning"
                       Variant="Variant.Filled">
                Clear
            </MudButton>
            <MudButton OnClick="OnCreate"
                       Color="Color.Primary"
                       Variant="Variant.Filled">
                Create
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudForm>

@code {
    private MudForm? _form;
    private NewVacancy _model = new();

    private async Task OnCreate()
    {
        if (_form is null)
            return;
        await _form.Validate();
        if (!_form.IsValid)
            return;
        
        var request = new CreateVacancyRequest
        {
            Name = _model.Title,
            Description = _model.Description,
            DefaultAcceptedToReviewText = _model.DefaultAcceptedToReviewText,
            DefaultRejectText = _model.DefaultRejectText
        };
        
        var result = await CreateVacancyService
            .CreateVacancy(request, CancellationToken.None);
        result.Match(
            _ => {
                Snackbar.Add("Vacancy created successfully!", Severity.Success);
                Navigation.NavigateTo(VacancyLinks.List);
            },
            ex => Snackbar.Add($"Error: {ex.Message}", Severity.Error)
        );
    }

    private void OnClear()
    {
        _model = new();
    }

    private void OnBack()
    {
        Navigation.NavigateTo(VacancyLinks.List);
    }
} 