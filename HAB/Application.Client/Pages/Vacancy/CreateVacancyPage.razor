@page "/vacancies/create"
@using UiShared.Sercvies
@using Application.Client.Components
@using Application.Client.Constants.Links
@using Application.Client.Extensions
@using Shared.Models.Vacancies
@using Application.Client.Pages.Vacancy.Components
@inject ICreateVacancy CreateVacancyService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<TitleBlock Title="Create New Vacancy" />

<MudForm @ref="_form">
    <MudStack Spacing="5">
        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h3">Vacancy Details</MudText>
            </MudCardHeader>
            <MudCardContent Style="display: flex; flex-direction: column; gap: 10px;">
                <MudTextField Label="Name"
                              @bind-Value="_vacancy.Title"
                              MaxLength="200"
                              Margin="Margin.Normal"
                              Required="true"/>

                <MudTextField Label="Description"
                              @bind-Value="_vacancy.Description"
                              MaxLength="1000"
                              AutoGrow="true"/>

                <MudTextField Label="Default accepted to review text"
                              @bind-Value="_vacancy.DefaultAcceptedToReviewText"
                              HelperText="Text shown to candidate when application is finished" MaxLength="1000"
                              AutoGrow="true"/>

                <MudTextField Label="Default rejected text"
                              @bind-Value="_vacancy.DefaultRejectText"
                              HelperText="Text shown to candidate when HR rejects application"
                              MaxLength="1000"
                              AutoGrow="true"/>
            </MudCardContent>
        </MudCard>
        
        <div style="display: flex;">
            <MudText Typo="Typo.h4">Questions</MudText>
            <MudSpacer/>
            <MudButton Color="Color.Primary"
                       OnClick="_vacancy.AddNewQuestion"
                       Variant="Variant.Filled"
                       Size="Size.Small">
                Add question
            </MudButton>
        </div>


        @foreach (var question in _vacancy.Questions.OrderBy(x => x.OrderNumber))
        {
            <QuestionEditor Question="@question"
                            OrderChanged="_vacancy.ReorderQuestions"
                            Delete="_vacancy.RemoveQuestion"/>
        }
        
        <MudCard>
        <MudCardActions Style="justify-content: end; gap: 30px;">
            <MudButton OnClick="OnBack"
                       Color="Color.Secondary"
                       Variant="Variant.Text">
                Back
            </MudButton>
            <MudButton OnClick="OnClear"
                       Color="Color.Warning"
                       Variant="Variant.Filled">
                Clear
            </MudButton>
            <MudButton OnClick="OnCreate"
                       Color="Color.Primary"
                       Variant="Variant.Filled">
                Create
            </MudButton>
        </MudCardActions>
    </MudCard>
    </MudStack>
</MudForm>

@code {
    private MudForm? _form;
    private NewVacancy _vacancy = new();

    private async Task OnCreate()
    {
        if (_form is null)
            return;
        await _form.Validate();
        if (!_form.IsValid)
            return;
        
        var request = new CreateVacancyRequest
        {
            Name = _vacancy.Title,
            Description = _vacancy.Description,
            DefaultAcceptedToReviewText = _vacancy.DefaultAcceptedToReviewText,
            DefaultRejectText = _vacancy.DefaultRejectText,
            Questions = _vacancy.Questions
                .OrderBy(x => x.OrderNumber)
                .HandleWithPrevious((prev, current) =>
                {
                    current.OrderNumber = prev == null ? 1 : prev.OrderNumber + 1;
                    return current;
                })
                .Select(q => new VacancyQuestionDto
            {
                Id = q.Id,
                Text = q.Text,
                OrderNumber = q.OrderNumber,
                Answer = q.Answer.MapToDto()
            }).ToList()
        };
        
        var result = await CreateVacancyService
            .CreateVacancy(request, CancellationToken.None);
        result.Match(
            _ => {
                Snackbar.Add("Vacancy created successfully!", Severity.Success);
                Navigation.NavigateTo(VacancyLinks.List);
            },
            ex => Snackbar.Add($"Error: {ex.Message}", Severity.Error)
        );
    }

    private void OnClear()
    {
        _vacancy = new();
    }

    private void OnBack()
    {
        Navigation.NavigateTo(VacancyLinks.List);
    }
} 