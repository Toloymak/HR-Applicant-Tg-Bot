@page "/vacancies/edit/{Id:guid}"
@using Application.Client.Constants.Links
@using UiShared.Sercvies
@using Application.Client.Pages.Vacancy.Components
@using Shared.Models
@using Shared.Models.Vacancies
@inject IEditVacancy EditVacancyService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IVacanciesProvider VacanciesProvider

<MudForm @ref="_form">
    <MudStack Spacing="5">
    <MudCard>
        <MudCardHeader>
            <MudText Typo="Typo.h3">Edit Vacancy</MudText>
        </MudCardHeader>
        <MudCardContent Style="display: flex; flex-direction: column; gap: 10px;">
            <MudTextField Label="Name" @bind-Value="_vacancy.Title" MaxLength="200" Margin="Margin.Normal" Required="true"/>
            <MudTextField Label="Description" @bind-Value="_vacancy.Description" MaxLength="1000" AutoGrow="true"/>
            <MudTextField Label="Default accepted to review text" @bind-Value="_vacancy.DefaultAcceptedToReviewText" HelperText="Text shown to candidate when application is finished" MaxLength="1000" AutoGrow="true"/>
            <MudTextField Label="Default rejected text" @bind-Value="_vacancy.DefaultRejectText" HelperText="Text shown to candidate when HR rejects application" MaxLength="1000" AutoGrow="true"/>
            <MudCheckBox T="bool" Label="Active" @bind-Value="_vacancy.IsActive" />
        </MudCardContent>
    </MudCard>

    <div style="display: flex;">
        <MudText Typo="Typo.h4">Questions</MudText>
        <MudSpacer/>
        @* <div> *@
            <MudButton Color="Color.Primary"
                       OnClick="@_vacancy.AddNewQuestion"
                       Variant="Variant.Filled"
                       Size="Size.Small">
                Add question
            </MudButton>
        @* </div> *@
    </div>

    
    @foreach (var question in _vacancy.Questions.OrderBy(x => x.OrderNumber))
    {
        <QuestionEditor Question="@question"
                        OrderChanged="_vacancy.ReorderQuestions"
                        Delete="_vacancy.RemoveQuestion"/>
    }
    
    <div style="display: flex;">
        <MudSpacer/>
        @* <div> *@
        <MudButton Color="Color.Primary"
                   OnClick="@_vacancy.AddNewQuestion"
                   Variant="Variant.Filled"
                   Size="Size.Small">
            Add question
        </MudButton>
        @* </div> *@
    </div>
    

    <MudCard>
        <MudCardActions Style="justify-content: end; gap: 30px;">
            <MudButton OnClick="@OnBack" Color="Color.Secondary" Variant="Variant.Text">
                Back
            </MudButton>
            <MudButton OnClick="@OnReset" Color="Color.Warning" Variant="Variant.Filled">
                Reset
            </MudButton>
            <MudButton OnClick="@OnEdit" Color="Color.Primary" Variant="Variant.Filled">
                Save
            </MudButton>
        </MudCardActions>
    </MudCard>
    </MudStack>
</MudForm>

@code {
    [Parameter] public Guid Id { get; set; }
    private MudForm? _form;
    private VacancyEdit _vacancy = new();
    private VacancyEdit? _original;

    protected override async Task OnInitializedAsync()
    {
        var result = await VacanciesProvider.GetVacancyById(Id, CancellationToken.None);
        result.Match(
            vacancy => {
                _vacancy = GetEditModel(vacancy);
                _original = GetEditModel(vacancy);
            },
            ex => Snackbar.Add($"Error loading vacancy: {ex.Message}", Severity.Error)
        );
    }

    private static VacancyEdit GetEditModel(VacancyDetailsDto vacancy)
    {
        Console.WriteLine(vacancy.Questions.FirstOrDefault()?.Answer.ToString() ?? "No questions found");
        var edit = new VacancyEdit
        {
            Id = vacancy.Id,
            Title = vacancy.Title,
            Description = vacancy.Description,
            DefaultAcceptedToReviewText = vacancy.DefaultAcceptedToReviewText,
            DefaultRejectText = vacancy.DefaultRejectText,
            IsActive = vacancy.IsActive,
            Questions = vacancy.Questions.Select(q =>
                new QuestionEdit
                (
                    id: q.Id,
                    text: q.Text,
                    orderNumber: q.OrderNumber,
                    answer: q.Answer switch
                    {
                        TextQuestionAnswerDto => new TextAnswer(),
                        YesNoQuestionAnswerDto =>
                            new YesNoAnswer
                            {
                                HasRequiredAnswer = false,
                                RequiredAnswer = null
                            },
                        YesNoWithRequiredCorrectQuestionAnswerDto yesNoWithRequired =>
                            new YesNoAnswer
                            {
                                HasRequiredAnswer = true,
                                RequiredAnswer = new YesNoAnswer.RequiredAnswerProperties()
                                {
                                    ExpectedAnswer = yesNoWithRequired.Expected,
                                    UnexpectedAnswerRejectText = yesNoWithRequired.UnexpectedAnswerRejectText
                                },
                            },
                        _ => throw new ArgumentOutOfRangeException()
                    })
            ).ToList()
        };
        
        Console.WriteLine(edit.Questions.FirstOrDefault()?.Answer.ToString() ?? "No questions found in edit model");
        return edit;
    }

    private async Task OnEdit()
    {
        if (_form is null)
            return;
        await _form.Validate();
        if (!_form.IsValid)
            return;
        var request = new EditVacancyRequest
        {
            Id = Id,
            Name = _vacancy.Title,
            Description = _vacancy.Description,
            DefaultAcceptedToReviewText = _vacancy.DefaultAcceptedToReviewText,
            DefaultRejectText = _vacancy.DefaultRejectText,
            IsActive = _vacancy.IsActive,
            Questions = _vacancy.Questions.Select(q => new VacancyQuestionDto()
            {
                Id = q.Id,
                Text = q.Text,
                OrderNumber = q.OrderNumber,
                Answer = q.Answer.MapToDto()
            }).ToList()
        };
        
        var result = await EditVacancyService.EditVacancy(request, CancellationToken.None);
        result.Match(
            _ =>
            {
                _original = _vacancy with { };
                Snackbar.Add("Vacancy updated successfully!", Severity.Success);
            },
            ex => Snackbar.Add($"Error: {ex.Message}", Severity.Error)
        );
    }

    private void OnReset()
    {
        if (_original is not null)
            _vacancy = new VacancyEdit
            {
                Id = _original.Id,
                Title = _original.Title,
                Description = _original.Description,
                DefaultAcceptedToReviewText = _original.DefaultAcceptedToReviewText,
                DefaultRejectText = _original.DefaultRejectText,
                IsActive = _original.IsActive,
                Questions = _original.Questions.Select(q => q with
                {
                    Answer = q.Answer.Copy()
                }).ToList()
            };
    }

    private void OnBack()
        => Navigation.NavigateTo(VacancyLinks.List);
} 